; Traduções do instalador NSIS do Tauri — Português (Brasil)
LangString addOrReinstall ${LANG_PORTUGUESEBR} "Atualizar/Reinstalar componentes"
LangString alreadyInstalled ${LANG_PORTUGUESEBR} "KardecAgent já está instalado"
LangString alreadyInstalledLong ${LANG_PORTUGUESEBR} "${PRODUCTNAME} ${VERSION} já está instalado. Escolha como deseja continuar e clique em Avançar."
LangString appRunning ${LANG_PORTUGUESEBR} "{{product_name}} está em execução. Feche o aplicativo e tente novamente."
LangString appRunningOkKill ${LANG_PORTUGUESEBR} "{{product_name}} está em execução. Clique em OK para encerrá-lo."
LangString chooseMaintenanceOption ${LANG_PORTUGUESEBR} "Escolha a operação que deseja realizar."
LangString choowHowToInstall ${LANG_PORTUGUESEBR} "Escolha como deseja instalar o ${PRODUCTNAME}."
LangString createDesktop ${LANG_PORTUGUESEBR} "Criar atalho do KardecAgent na área de trabalho"
LangString dontUninstall ${LANG_PORTUGUESEBR} "Atualizar mantendo a instalação atual, os projetos e as configurações"
LangString dontUninstallDowngrade ${LANG_PORTUGUESEBR} "Manter a instalação atual (não é possível atualizar para uma versão anterior sem desinstalar)"
LangString failedToKillApp ${LANG_PORTUGUESEBR} "Não foi possível encerrar {{product_name}}. Feche o aplicativo e tente novamente."
LangString installingWebview2 ${LANG_PORTUGUESEBR} "Instalando o WebView2..."
LangString newerVersionInstalled ${LANG_PORTUGUESEBR} "Uma versão mais recente do ${PRODUCTNAME} já está instalada. Para instalar uma versão anterior, desinstale a versão atual primeiro."
LangString older ${LANG_PORTUGUESEBR} "anterior"
LangString olderOrUnknownVersionInstalled ${LANG_PORTUGUESEBR} "Uma versão $R4 do ${PRODUCTNAME} já está instalada. Escolha se deseja atualizar mantendo a instalação ou desinstalar antes de continuar."
LangString silentDowngrades ${LANG_PORTUGUESEBR} "A instalação silenciosa de versões anteriores está desativada. Use o instalador com interface gráfica."
LangString unableToUninstall ${LANG_PORTUGUESEBR} "Não foi possível desinstalar o KardecAgent."
LangString uninstallApp ${LANG_PORTUGUESEBR} "Desinstalar KardecAgent (remove o aplicativo)"
LangString uninstallBeforeInstalling ${LANG_PORTUGUESEBR} "Desinstalar antes de instalar (não recomendado para atualizações)"
LangString unknown ${LANG_PORTUGUESEBR} "desconhecida"
LangString webview2AbortError ${LANG_PORTUGUESEBR} "Falha ao instalar o WebView2. O aplicativo não pode ser executado sem ele."
LangString webview2DownloadError ${LANG_PORTUGUESEBR} "Falha ao baixar o WebView2: $0"
LangString webview2DownloadSuccess ${LANG_PORTUGUESEBR} "Instalador do WebView2 baixado com sucesso."
LangString webview2Downloading ${LANG_PORTUGUESEBR} "Baixando o instalador do WebView2..."
LangString webview2InstallError ${LANG_PORTUGUESEBR} "A instalação do WebView2 falhou com o código $1."
LangString webview2InstallSuccess ${LANG_PORTUGUESEBR} "WebView2 instalado com sucesso."
LangString deleteAppData ${LANG_PORTUGUESEBR} "Remover também os dados locais do aplicativo"
