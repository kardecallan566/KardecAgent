{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KardecAgent Studio",
  "version": "0.1.3",
  "identifier": "dev.kardecagent.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KardecAgent Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' data: asset: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "customLanguageFiles": {
          "PortugueseBR": "windows/PortugueseBR.nsh",
          "English": "windows/English.nsh"
        }
      }
    },
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first agent development workspace",
    "resources": [
      "core-dist/*"
    ]
  }
}
