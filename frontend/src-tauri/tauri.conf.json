{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KardecAgent Studio",
  "version": "0.1.0",
  "identifier": "dev.kardecagent.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "KardecAgent Studio",
      "width": 1440,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 650
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "DeveloperTool",
    "shortDescription": "Local-first agent development workspace"
  }
}